# Copy to .env and adjust. Docker Compose and run.py read these.

# Unique per worktree so containers, networks and volumes don't clash.
COMPOSE_PROJECT_NAME=movie-service

# Host ports (0 = pick a random free port).
API_PORT=8000
POSTGRES_PORT=5432

POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_DB=movies

# Required in the X-API-Key header for POST /imports and POST /exports.
API_KEY=dev-api-key

# 64 MB: sized for ~750k movies (DESIGN.md §8).
MAX_UPLOAD_BYTES=67108864
STATEMENT_TIMEOUT_MS=5000
LOG_LEVEL=INFO
