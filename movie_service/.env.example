# Copy to .env and adjust. Docker Compose and run.py read these.

# Unique per worktree so containers, networks and volumes don't clash.
COMPOSE_PROJECT_NAME=movie-service

# Host ports. Leave unset for defaults: the API on 8000 or the next free port (chosen by
# run.py), Postgres on a random localhost-only port. 0 = random.
# API_PORT=8000
# POSTGRES_PORT=5432

POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_DB=movies

# Required in the X-API-Key header for POST /imports and POST /exports; at least 16
# characters, no default. Leave empty and `run.py up` generates one, or set your own:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=

# 64 MB: sized for ~750k movies (DESIGN.md §8).
MAX_UPLOAD_BYTES=67108864
STATEMENT_TIMEOUT_MS=5000
LOG_LEVEL=INFO

# Worker: number of replicas and crash detection (a running job with no heartbeat
# for JOB_STALE_SECONDS is marked failed).
WORKER_REPLICAS=1
JOB_HEARTBEAT_SECONDS=5
JOB_STALE_SECONDS=60
JOB_SWEEP_INTERVAL_SECONDS=15

# Caching (DESIGN.md §13). Responses may be served from client/CDN caches for up to
# CACHE_MAX_AGE_SECONDS after an import; lower it if fresher results matter more.
CACHE_MAX_AGE_SECONDS=3600
CACHE_TTL_SECONDS=3600
CACHE_RETRY_SECONDS=10
REDIS_MAXMEMORY=256mb
